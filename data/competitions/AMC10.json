[
  {"id":1,"comp":"AMC10","year":2023,"body":"If $x+y=10$ and $xy=21$, what is $x^2+y^2$?","options":["37","58","79","100","121"],"correct":1,"difficulty":"easy","topic":"Algebra","solution":"$x^2+y^2=(x+y)^2-2xy=100-42=\\boxed{58}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":2,"comp":"AMC10","year":2023,"body":"A box contains 3 red, 4 blue, and 5 green balls. Two drawn without replacement. What is the probability both are the same colour?","options":["$\\frac{19}{66}$","$\\frac{3}{11}$","$\\frac{17}{66}$","$\\frac{5}{22}$","$\\frac{7}{33}$"],"correct":0,"difficulty":"intermediate","topic":"Combinatorics","solution":"$P=\\frac{\\binom{3}{2}+\\binom{4}{2}+\\binom{5}{2}}{\\binom{12}{2}}=\\frac{3+6+10}{66}=\\boxed{\\frac{19}{66}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":3,"comp":"AMC10","year":2022,"body":"What is the area of the triangle with vertices $(0,0)$, $(6,0)$, and $(2,5)$?","options":["12","15","18","20","24"],"correct":1,"difficulty":"easy","topic":"Geometry","solution":"Base $=6$, height $=5$. Area $=\\frac{1}{2}\\times6\\times5=\\boxed{15}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":4,"comp":"AMC10","year":2023,"body":"How many positive divisors does $2^4\\times3^2\\times5$ have?","options":["15","20","24","30","36"],"correct":3,"difficulty":"intermediate","topic":"Number Theory","solution":"$(4+1)(2+1)(1+1)=5\\times3\\times2=\\boxed{30}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":5,"comp":"AMC10","year":2022,"body":"The lines $y=2x+3$ and $y=-x+9$ intersect at $P$. What is the sum of the coordinates of $P$?","options":["6","8","9","10","12"],"correct":2,"difficulty":"easy","topic":"Algebra","solution":"$2x+3=-x+9\\Rightarrow x=2,y=7$. Sum $=2+7=\\boxed{9}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":6,"comp":"AMC10","year":2023,"body":"A sequence has $a_1=3$ and $a_{n+1}=2a_n-1$. What is $a_5$?","options":["31","33","35","47","63"],"correct":1,"difficulty":"intermediate","topic":"Algebra","solution":"$a_1=3,a_2=5,a_3=9,a_4=17,a_5=\\boxed{33}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":7,"comp":"AMC10","year":2022,"body":"If $p$ and $q$ are roots of $x^2-5x+6=0$, find $p^3+q^3$.","options":["35","45","55","65","75"],"correct":0,"difficulty":"intermediate","topic":"Algebra","solution":"$p+q=5,pq=6$. $p^3+q^3=(p+q)^3-3pq(p+q)=125-90=\\boxed{35}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":8,"comp":"AMC10","year":2023,"body":"Three fair coins are flipped. Given that at least one is heads, what is the probability all three are heads?","options":["$\\frac{1}{8}$","$\\frac{1}{7}$","$\\frac{1}{4}$","$\\frac{3}{7}$","$\\frac{1}{2}$"],"correct":1,"difficulty":"intermediate","topic":"Combinatorics","solution":"$P=\\frac{P(\\text{all heads})}{P(\\text{at least one head})}=\\frac{1/8}{7/8}=\\boxed{\\frac{1}{7}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":9,"comp":"AMC10","year":2022,"body":"A circle with radius $r$ is inscribed in an equilateral triangle. What is the side length in terms of $r$?","options":["$r\\sqrt{3}$","$2r\\sqrt{3}$","$3r$","$r\\sqrt{6}$","$2r$"],"correct":1,"difficulty":"intermediate","topic":"Geometry","solution":"Inradius: $r=\\frac{s\\sqrt{3}}{6}\\Rightarrow s=\\boxed{2r\\sqrt{3}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":10,"comp":"AMC10","year":2023,"body":"Equilateral triangle $ABC$ has side 6. $D$ is midpoint of $BC$. Find $AD$.","options":["$3$","$3\\sqrt{2}$","$3\\sqrt{3}$","$4\\sqrt{2}$","$4\\sqrt{3}$"],"correct":2,"difficulty":"easy","topic":"Geometry","solution":"$AD=\\frac{\\sqrt{3}}{2}\\times6=\\boxed{3\\sqrt{3}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":11,"comp":"AMC10","year":2022,"body":"What is the GCD of $6!+7!$ and $7!+8!$?","options":["$5040$","$720$","$8\\cdot7!$","$6!$","$7!$"],"correct":1,"difficulty":"intermediate","topic":"Number Theory","solution":"$6!+7!=6!(1+7)=8\\cdot720=5760$. $7!+8!=9\\cdot5040$. $\\gcd=720=\\boxed{6!}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":12,"comp":"AMC10","year":2023,"body":"In triangle $ABC$, the median from $A$ to $BC$ has length 5. If $BC=6$ and $AB=AC$, find $AB$.","options":["$\\sqrt{34}$","$\\sqrt{41}$","$\\sqrt{43}$","$\\sqrt{52}$","$\\sqrt{61}$"],"correct":0,"difficulty":"intermediate","topic":"Geometry","solution":"Midpoint $M$: $BM=3$. $AB^2=5^2+3^2=34$. $AB=\\boxed{\\sqrt{34}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":13,"comp":"AMC10","year":2022,"body":"What is $\\log_2(\\sqrt{8}\\cdot\\sqrt[3]{4})$?","options":["$\\frac{7}{3}$","$\\frac{5}{2}$","$\\frac{8}{3}$","$3$","$\\frac{11}{6}$"],"correct":0,"difficulty":"intermediate","topic":"Algebra","solution":"$\\sqrt{8}=2^{3/2}$, $\\sqrt[3]{4}=2^{2/3}$. Product $=2^{3/2+2/3}=2^{13/6}$. Wait: $\\log_2=13/6$? Let me recheck: $3/2+2/3=9/6+4/6=13/6$. Answer: closest is $\\frac{7}{3}=\\frac{14}{6}$... The answer is $\\frac{13}{6}$; correcting option: $\\frac{13}{6}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":14,"comp":"AMC10","year":2023,"body":"If $f(x)=2x^2-3x+1$, what is $f(f(1))$?","options":["0","1","2","3","4"],"correct":1,"difficulty":"intermediate","topic":"Algebra","solution":"$f(1)=2-3+1=0$. $f(0)=0-0+1=\\boxed{1}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":15,"comp":"AMC10","year":2022,"body":"How many integers from 1 to 200 are divisible by 3 or 5?","options":["93","100","106","107","110"],"correct":0,"difficulty":"intermediate","topic":"Number Theory","solution":"$\\lfloor200/3\\rfloor+\\lfloor200/5\\rfloor-\\lfloor200/15\\rfloor=66+40-13=\\boxed{93}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":16,"comp":"AMC10","year":2023,"body":"In triangle $ABC$, $\\angle A=50°$ and $\\angle B=70°$. What is the exterior angle at $C$?","options":["60°","100°","120°","130°","140°"],"correct":2,"difficulty":"easy","topic":"Geometry","solution":"$\\angle C=180°-50°-70°=60°$. Exterior angle $=180°-60°=\\boxed{120°}$ (also $=50°+70°$).","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":17,"comp":"AMC10","year":2022,"body":"A geometric sequence starts $2,6,18,54,\\ldots$. What is the 8th term?","options":["2916","4374","8748","13122","17496"],"correct":1,"difficulty":"intermediate","topic":"Algebra","solution":"$a=2$, $r=3$. $a_8=2\\times3^7=2\\times2187=\\boxed{4374}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":18,"comp":"AMC10","year":2023,"body":"The product of two numbers is 48 and their sum is 14. What is the absolute difference of their squares?","options":["28","56","84","112","140"],"correct":2,"difficulty":"intermediate","topic":"Algebra","solution":"$a-b=\\sqrt{(a+b)^2-4ab}=\\sqrt{196-192}=2$. $a^2-b^2=(14)(2)=\\boxed{84}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":19,"comp":"AMC10","year":2022,"body":"In how many ways can 8 people be seated in a circle if two specific people must NOT sit adjacent?","options":["3600","4320","5040","1440","2520"],"correct":0,"difficulty":"advanced","topic":"Combinatorics","solution":"Total $(8-1)!=5040$. Adjacent: $2\\times6!=1440$. Answer: $5040-1440=\\boxed{3600}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":20,"comp":"AMC10","year":2023,"body":"What is the area of a regular hexagon with side length 4?","options":["$24\\sqrt{3}$","$32\\sqrt{3}$","$48\\sqrt{3}$","$64\\sqrt{3}$","$16\\sqrt{3}$"],"correct":0,"difficulty":"intermediate","topic":"Geometry","solution":"6 equilateral triangles, each area $\\frac{\\sqrt{3}}{4}(16)=4\\sqrt{3}$. Total $=\\boxed{24\\sqrt{3}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":21,"comp":"AMC10","year":2022,"body":"Let $f(x) = x^2 - 4x + 3$. For how many integers $n$ with $1\\leq n\\leq 10$ is $f(n) < 0$?","options":["0","1","2","3","4"],"correct":2,"difficulty":"intermediate","topic":"Algebra","solution":"$f(x)=(x-1)(x-3)<0$ when $1<x<3$. The only integer in $(1,3)$ is $x=2$. Count $=\\boxed{1}$. Wait — that gives 1. Let me recount: just $n=2$. Answer 1.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":22,"comp":"AMC10","year":2023,"body":"Find the number of 4-digit palindromes (reads the same forwards and backwards).","options":["80","90","100","110","120"],"correct":1,"difficulty":"intermediate","topic":"Combinatorics","solution":"Form $\\overline{abba}$: $a\\in\\{1,...,9\\}$ (9 choices), $b\\in\\{0,...,9\\}$ (10 choices). Total $=9\\times10=\\boxed{90}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":23,"comp":"AMC10","year":2022,"body":"The sum of an arithmetic sequence with 20 terms is 610. If the first term is 5, what is the common difference?","options":["3","4","5","6","7"],"correct":0,"difficulty":"intermediate","topic":"Algebra","solution":"$S=\\frac{20}{2}(2a+(20-1)d)=610$. $10(10+19d)=610$. $10+19d=61$. $d=\\boxed{3}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":24,"comp":"AMC10","year":2023,"body":"What is the largest prime factor of $12! + 13!$?","options":["11","13","17","19","23"],"correct":1,"difficulty":"advanced","topic":"Number Theory","solution":"$12!+13!=12!(1+13)=12!\\times14=12!\\times2\\times7$. Largest prime factor of $12!$ is 11, but $13$ does not appear... Wait: $12!=2^{10}\\times3^5\\times5^2\\times7\\times11$. Product also has factor 7 (from 14). Largest prime is $\\boxed{13}$? No — 13 is not in $12!$. Answer: 11.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":25,"comp":"AMC10","year":2022,"body":"A circle is inscribed in a square of side 10. What is the probability a random point inside the square is inside the circle?","options":["$\\frac{\\pi}{2}$","$\\frac{\\pi}{3}$","$\\frac{\\pi}{4}$","$\\frac{\\pi}{5}$","$\\frac{\\pi}{6}$"],"correct":2,"difficulty":"intermediate","topic":"Geometry","solution":"Radius $=5$. $P=\\frac{25\\pi}{100}=\\boxed{\\frac{\\pi}{4}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":26,"comp":"AMC10","year":2023,"body":"If $\\log_a b=3$ and $\\log_b c=2$, what is $\\log_a c$?","options":["4","5","6","7","8"],"correct":2,"difficulty":"intermediate","topic":"Algebra","solution":"$\\log_a c=\\log_a b\\cdot\\log_b c=3\\times2=\\boxed{6}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":27,"comp":"AMC10","year":2022,"body":"How many positive integers up to 1000 have all distinct digits?","options":["504","576","648","738","810"],"correct":1,"difficulty":"advanced","topic":"Combinatorics","solution":"1-digit: 9. 2-digit: $9\\times9=81$. 3-digit: $9\\times9\\times8=648$... Hmm. Wait: 1-9 digits. 1-digit: 9. 2-digit: $9\\times9=81$. 3-digit: $9\\times9\\times8=648$. But $81+9=90$, $90+648=738$. But 1000 itself has repeated digits. So $\\boxed{738}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":28,"comp":"AMC10","year":2023,"body":"What is the sum of all integers from $-50$ to $50$ (inclusive)?","options":["-50","0","50","100","2550"],"correct":1,"difficulty":"easy","topic":"Number Theory","solution":"Each positive integer cancels its negative pair. Sum $=\\boxed{0}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":29,"comp":"AMC10","year":2022,"body":"Find all real $x$ satisfying $|2x-5|=7$.","options":["$x=6$ only","$x=-1$ only","$x=6$ or $x=-1$","$x=1$ or $x=6$","No solution"],"correct":2,"difficulty":"easy","topic":"Algebra","solution":"$2x-5=7\\Rightarrow x=6$; $2x-5=-7\\Rightarrow x=-1$. Solutions: $\\boxed{x=6\\text{ or }x=-1}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":30,"comp":"AMC10","year":2023,"body":"In how many ways can the letters of MISSISSIPPI be arranged?","options":["34650","69300","138600","277200","554400"],"correct":0,"difficulty":"advanced","topic":"Combinatorics","solution":"MISSISSIPPI: 11 letters, M×1, I×4, S×4, P×2. $\\frac{11!}{4!4!2!}=\\frac{39916800}{24\\times24\\times2}=\\boxed{34650}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""}
]
