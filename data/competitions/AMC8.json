[
  {"id":1,"comp":"AMC8","year":2023,"body":"What is $25\\%$ of $80$?","options":["15","18","20","22","25"],"correct":2,"difficulty":"easy","topic":"Number Theory","solution":"$25\\% = \\frac{1}{4}$. So $\\frac{1}{4} \\times 80 = \\boxed{20}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":2,"comp":"AMC8","year":2023,"body":"A rectangle has length $2x+3$ and width $x-1$. If the perimeter is 28, what is $x$?","options":["3","4","5","6","7"],"correct":1,"difficulty":"easy","topic":"Algebra","solution":"$2[(2x+3)+(x-1)]=28 \\Rightarrow 6x+4=28 \\Rightarrow x=\\boxed{4}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":3,"comp":"AMC8","year":2022,"body":"What is the sum of all positive factors of 36?","options":["55","91","96","104","108"],"correct":1,"difficulty":"intermediate","topic":"Number Theory","solution":"$36=2^2\\times3^2$. Sum of factors $=(1+2+4)(1+3+9)=7\\times13=\\boxed{91}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":4,"comp":"AMC8","year":2023,"body":"Alice walks 3 km north then 4 km east. How far is she from her starting point?","options":["5 km","6 km","7 km","8 km","9 km"],"correct":0,"difficulty":"easy","topic":"Geometry","solution":"By the Pythagorean theorem: $\\sqrt{3^2+4^2}=\\sqrt{25}=\\boxed{5}$ km.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":5,"comp":"AMC8","year":2022,"body":"How many two-digit numbers have digits whose sum equals 9?","options":["7","8","9","10","11"],"correct":2,"difficulty":"intermediate","topic":"Combinatorics","solution":"Pairs $(a,b)$ with $a+b=9$, $a\\geq1$: $(1,8),(2,7),(3,6),(4,5),(5,4),(6,3),(7,2),(8,1),(9,0)$ — that is $\\boxed{9}$ numbers.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":6,"comp":"AMC8","year":2023,"body":"A store sells apples at 3 for $\\$1.00$. How much do 15 apples cost?","options":["$\\$3.00$","$\\$4.00$","$\\$5.00$","$\\$6.00$","$\\$7.00$"],"correct":2,"difficulty":"easy","topic":"Word Problem","solution":"$15 \\div 3 = 5$ groups. Cost $= 5 \\times \\$1.00 = \\boxed{\\$5.00}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":7,"comp":"AMC8","year":2022,"body":"The angles of a triangle are in ratio $1:2:3$. What type of triangle is it?","options":["Acute","Obtuse","Right","Equilateral","Isosceles only"],"correct":2,"difficulty":"easy","topic":"Geometry","solution":"Angles are $30°, 60°, 90°$. Since one angle is $90°$, it is a right triangle.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":8,"comp":"AMC8","year":2023,"body":"How many integers between 1 and 50 have an odd number of factors?","options":["5","6","7","8","9"],"correct":2,"difficulty":"intermediate","topic":"Number Theory","solution":"A number has an odd number of factors if and only if it is a perfect square. Perfect squares from 1 to 50: $1,4,9,16,25,36,49$ — that is $\\boxed{7}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":9,"comp":"AMC8","year":2022,"body":"A 6×6 grid has exactly $\\frac{1}{3}$ of its squares painted red. How many squares are red?","options":["10","12","14","16","18"],"correct":1,"difficulty":"easy","topic":"Word Problem","solution":"Total squares $= 36$. Red $= \\frac{1}{3}\\times36 = \\boxed{12}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":10,"comp":"AMC8","year":2023,"body":"What is the smallest 4-digit number divisible by both 6 and 9?","options":["1008","1014","1018","1026","1044"],"correct":0,"difficulty":"intermediate","topic":"Number Theory","solution":"$\\text{lcm}(6,9)=18$. Smallest 4-digit multiple: $\\lceil1000/18\\rceil=56$, so $56\\times18=\\boxed{1008}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":11,"comp":"AMC8","year":2022,"body":"If $3x - 7 = 14$, what is the value of $6x$?","options":["21","42","63","7","14"],"correct":1,"difficulty":"easy","topic":"Algebra","solution":"$3x=21 \\Rightarrow x=7$. So $6x=\\boxed{42}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":12,"comp":"AMC8","year":2023,"body":"A bag contains 4 red, 3 blue, and 5 green marbles. One marble is selected at random. What is the probability it is NOT red?","options":["$\\frac{1}{3}$","$\\frac{2}{3}$","$\\frac{1}{4}$","$\\frac{3}{4}$","$\\frac{5}{12}$"],"correct":1,"difficulty":"easy","topic":"Combinatorics","solution":"Not red: $3+5=8$ marbles out of 12. $P = \\frac{8}{12} = \\boxed{\\frac{2}{3}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":13,"comp":"AMC8","year":2022,"body":"What is the area of a right triangle with legs of length 6 and 8?","options":["14","24","36","48","52"],"correct":1,"difficulty":"easy","topic":"Geometry","solution":"Area $= \\frac{1}{2}\\times6\\times8 = \\boxed{24}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":14,"comp":"AMC8","year":2023,"body":"The average of five numbers is 18. If four of the numbers are 12, 15, 20, and 25, what is the fifth?","options":["16","18","20","22","24"],"correct":1,"difficulty":"easy","topic":"Algebra","solution":"Sum $=5\\times18=90$. Known sum $=12+15+20+25=72$. Fifth $=90-72=\\boxed{18}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":15,"comp":"AMC8","year":2022,"body":"A square has perimeter 36 cm. What is its area?","options":["36 cm²","64 cm²","81 cm²","100 cm²","49 cm²"],"correct":2,"difficulty":"easy","topic":"Geometry","solution":"Side $= 36\\div4 = 9$ cm. Area $= 9^2 = \\boxed{81}$ cm².","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":16,"comp":"AMC8","year":2023,"body":"What is the value of $2^{10}$?","options":["512","1000","1024","2048","256"],"correct":2,"difficulty":"easy","topic":"Number Theory","solution":"$2^{10} = 2^5 \\times 2^5 = 32 \\times 32 = \\boxed{1024}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":17,"comp":"AMC8","year":2022,"body":"If today is Tuesday, what day will it be 100 days from now?","options":["Monday","Tuesday","Wednesday","Thursday","Friday"],"correct":3,"difficulty":"intermediate","topic":"Number Theory","solution":"$100 = 14\\times7 + 2$. Two days after Tuesday is $\\boxed{\\text{Thursday}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":18,"comp":"AMC8","year":2023,"body":"In a class of 30 students, $\\frac{2}{5}$ are boys. How many girls are in the class?","options":["10","12","15","18","20"],"correct":3,"difficulty":"easy","topic":"Word Problem","solution":"Boys $= \\frac{2}{5}\\times30 = 12$. Girls $= 30-12 = \\boxed{18}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":19,"comp":"AMC8","year":2022,"body":"What is the LCM of 8 and 12?","options":["4","16","24","48","96"],"correct":2,"difficulty":"easy","topic":"Number Theory","solution":"$8=2^3$, $12=2^2\\times3$. LCM $=2^3\\times3=\\boxed{24}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":20,"comp":"AMC8","year":2023,"body":"A car travels 150 km in 2.5 hours. What is its average speed?","options":["50 km/h","55 km/h","60 km/h","65 km/h","70 km/h"],"correct":2,"difficulty":"easy","topic":"Word Problem","solution":"Speed $= \\frac{150}{2.5} = \\boxed{60}$ km/h.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":21,"comp":"AMC8","year":2022,"body":"What is the median of the set $\\{3, 7, 1, 9, 5, 2, 8\\}$?","options":["3","5","7","4","6"],"correct":1,"difficulty":"easy","topic":"Word Problem","solution":"Sorted: $1,2,3,5,7,8,9$. The middle value (4th) is $\\boxed{5}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":22,"comp":"AMC8","year":2023,"body":"How many prime numbers are there between 20 and 40?","options":["3","4","5","6","7"],"correct":1,"difficulty":"intermediate","topic":"Number Theory","solution":"Primes in range: 23, 29, 31, 37. Count $= \\boxed{4}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":23,"comp":"AMC8","year":2022,"body":"A recipe calls for $2\\frac{1}{2}$ cups of flour for 12 cookies. How many cups are needed for 30 cookies?","options":["$5$","$6\\frac{1}{4}$","$6$","$6\\frac{2}{3}$","$5\\frac{3}{4}$"],"correct":1,"difficulty":"intermediate","topic":"Word Problem","solution":"$\\frac{2.5}{12}\\times30 = \\frac{75}{12} = 6.25 = \\boxed{6\\frac{1}{4}}$ cups.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":24,"comp":"AMC8","year":2023,"body":"The sum of interior angles of a polygon is 1080°. How many sides does it have?","options":["6","7","8","9","10"],"correct":2,"difficulty":"intermediate","topic":"Geometry","solution":"$(n-2)\\times180=1080 \\Rightarrow n-2=6 \\Rightarrow n=\\boxed{8}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":25,"comp":"AMC8","year":2022,"body":"What is $\\frac{1}{2}+\\frac{1}{3}+\\frac{1}{6}$?","options":["$\\frac{2}{3}$","$\\frac{5}{6}$","$1$","$\\frac{7}{6}$","$\\frac{11}{12}$"],"correct":2,"difficulty":"easy","topic":"Number Theory","solution":"$\\frac{3}{6}+\\frac{2}{6}+\\frac{1}{6}=\\frac{6}{6}=\\boxed{1}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":26,"comp":"AMC8","year":2023,"body":"In a survey of 40 students, 25 like math and 20 like science. If 10 like both, how many like neither?","options":["3","5","7","8","10"],"correct":1,"difficulty":"intermediate","topic":"Combinatorics","solution":"By inclusion-exclusion: $|M\\cup S|=25+20-10=35$. Neither $=40-35=\\boxed{5}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":27,"comp":"AMC8","year":2022,"body":"A number is divisible by 3 if the sum of its digits is divisible by 3. Which of the following is divisible by 3?","options":["124","235","341","456","523"],"correct":3,"difficulty":"easy","topic":"Number Theory","solution":"Check digit sums: $4+5+6=15$, which is divisible by 3. Answer: $\\boxed{456}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":28,"comp":"AMC8","year":2023,"body":"A triangle has sides 5, 12, and 13. What is its area?","options":["25","30","60","65","78"],"correct":1,"difficulty":"intermediate","topic":"Geometry","solution":"$5^2+12^2=25+144=169=13^2$, so it is a right triangle. Area $=\\frac{1}{2}\\times5\\times12=\\boxed{30}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":29,"comp":"AMC8","year":2022,"body":"If $n! = 120$, what is $n$?","options":["4","5","6","7","8"],"correct":1,"difficulty":"intermediate","topic":"Combinatorics","solution":"$5! = 5\\times4\\times3\\times2\\times1 = \\boxed{120}$, so $n=5$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":30,"comp":"AMC8","year":2023,"body":"What is the value of $\\sqrt{144} + \\sqrt{25}$?","options":["13","15","17","19","21"],"correct":2,"difficulty":"easy","topic":"Number Theory","solution":"$\\sqrt{144}=12$, $\\sqrt{25}=5$. Sum $=12+5=\\boxed{17}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""}
]
