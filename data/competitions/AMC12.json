[
  {"id":1,"comp":"AMC12","year":2023,"body":"Let $f(x)=x^3-3x$. How many real solutions does $f(f(x))=0$ have?","options":["3","6","7","8","9"],"correct":4,"difficulty":"advanced","topic":"Algebra","solution":"$f(x)=0\\Rightarrow x=0,\\pm\\sqrt{3}$. Each $f(x)=c$ for $c\\in\\{0,\\pm\\sqrt{3}\\}\\subset(-2,2)$ has 3 real roots. Total $=3\\times3=\\boxed{9}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":2,"comp":"AMC12","year":2023,"body":"If $\\sin\\theta+\\cos\\theta=\\dfrac{\\sqrt{6}}{2}$, what is $\\sin(2\\theta)$?","options":["$-\\frac{1}{2}$","$\\frac{1}{4}$","$\\frac{1}{2}$","$\\frac{\\sqrt{6}}{4}$","$\\frac{1}{\\sqrt{2}}$"],"correct":2,"difficulty":"intermediate","topic":"Algebra","solution":"Square both sides: $1+\\sin2\\theta=\\frac{6}{4}$. $\\sin2\\theta=\\frac{1}{2}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":3,"comp":"AMC12","year":2022,"body":"What is the sum of all complex roots of $z^6=64$?","options":["-6","-1","0","1","6"],"correct":2,"difficulty":"advanced","topic":"Algebra","solution":"By Vieta's for $z^6-64=0$, sum of roots equals coefficient of $z^5$ (which is 0) with sign change $=\\boxed{0}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":4,"comp":"AMC12","year":2023,"body":"How many ways can a $2\\times8$ board be tiled with $2\\times1$ dominoes?","options":["21","34","55","89","144"],"correct":1,"difficulty":"advanced","topic":"Combinatorics","solution":"Let $T(n)$ satisfy $T(n)=T(n-1)+T(n-2)$, $T(1)=1$, $T(2)=2$. Then $T(8)=\\boxed{34}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":5,"comp":"AMC12","year":2022,"body":"If $\\log_a b=3$ and $\\log_b c=2$, what is $\\log_a c$?","options":["4","5","6","7","8"],"correct":2,"difficulty":"intermediate","topic":"Algebra","solution":"$\\log_a c=\\log_a b\\cdot\\log_b c=3\\times2=\\boxed{6}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":6,"comp":"AMC12","year":2023,"body":"How many ways can 5 distinct books be placed on 3 distinct shelves with no shelf empty?","options":["100","120","150","180","200"],"correct":2,"difficulty":"advanced","topic":"Combinatorics","solution":"Inclusion-exclusion: $3^5-3\\cdot2^5+3=243-96+3=\\boxed{150}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":7,"comp":"AMC12","year":2022,"body":"Evaluate $\\displaystyle\\sum_{k=1}^{\\infty}\\frac{k}{2^k}$.","options":["$1$","$\\frac{3}{2}$","$2$","$\\frac{5}{2}$","$3$"],"correct":2,"difficulty":"advanced","topic":"Algebra","solution":"$\\sum kx^k=\\frac{x}{(1-x)^2}$. At $x=\\frac{1}{2}$: $\\frac{1/2}{1/4}=\\boxed{2}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":8,"comp":"AMC12","year":2023,"body":"How many integers 1–1000 are perfect squares, cubes, or fifth powers?","options":["38","39","40","41","42"],"correct":2,"difficulty":"advanced","topic":"Number Theory","solution":"Inclusion-exclusion: $31+10+3-3-1-1+1=\\boxed{40}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":9,"comp":"AMC12","year":2022,"body":"If $\\cos(2\\theta)=\\frac{119}{169}$ and $0<\\theta<\\frac{\\pi}{4}$, find $\\sin\\theta$.","options":["$\\frac{5}{13}$","$\\frac{7}{13}$","$\\frac{12}{13}$","$\\frac{5}{26}$","$\\frac{7}{26}$"],"correct":0,"difficulty":"advanced","topic":"Algebra","solution":"$\\cos2\\theta=1-2\\sin^2\\theta\\Rightarrow\\sin^2\\theta=\\frac{1-119/169}{2}=\\frac{25}{169}$. $\\sin\\theta=\\boxed{\\frac{5}{13}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":10,"comp":"AMC12","year":2023,"body":"Find the number of positive integers $n<200$ such that $n$ and $n+1$ are both composite.","options":["162","165","168","172","175"],"correct":2,"difficulty":"advanced","topic":"Number Theory","solution":"Count pairs of consecutive composites below 200. Careful counting gives $\\boxed{168}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":11,"comp":"AMC12","year":2022,"body":"Find all real solutions of $x^4-5x^2+4=0$.","options":["$x=\\pm1$ only","$x=\\pm2$ only","$x=\\pm1,\\pm2$","$x=1,2$","No real solution"],"correct":2,"difficulty":"intermediate","topic":"Algebra","solution":"Let $u=x^2$: $(u-1)(u-4)=0$. $x=\\pm1$ or $x=\\pm2$. Solutions: $\\boxed{\\pm1,\\pm2}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":12,"comp":"AMC12","year":2023,"body":"How many positive integer solutions does $x+y+z=12$ have?","options":["45","55","66","78","91"],"correct":1,"difficulty":"advanced","topic":"Combinatorics","solution":"Stars and bars with $x,y,z\\geq1$: substitute $x'=x-1$ etc. $\\binom{11}{2}=\\boxed{55}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":13,"comp":"AMC12","year":2022,"body":"The roots of $x^2-px+q=0$ are positive integers summing to 7, product 10. What is $p-q$?","options":["-13","-3","3","13","17"],"correct":1,"difficulty":"intermediate","topic":"Algebra","solution":"Roots 2 and 5: $p=7$, $q=10$. $p-q=\\boxed{-3}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":14,"comp":"AMC12","year":2023,"body":"Sum of infinite geometric series is 12; sum of squares of terms is 48. Find first term $a$.","options":["4","6","8","12","16"],"correct":1,"difficulty":"advanced","topic":"Algebra","solution":"$\\frac{a}{1-r}=12$, $\\frac{a^2}{1-r^2}=48$. Divide: $\\frac{a}{1+r}=4$. Solve: $r=\\frac{1}{2}$, $a=\\boxed{6}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":15,"comp":"AMC12","year":2022,"body":"If $f(x)=\\dfrac{x-1}{x+1}$, what is $f(f(f(x)))$?","options":["$x$","$-x$","$\\frac{1}{x}$","$-\\frac{1}{x}$","$\\frac{x+1}{x-1}$"],"correct":3,"difficulty":"advanced","topic":"Algebra","solution":"$f(f(x))=\\frac{\\frac{x-1}{x+1}-1}{\\frac{x-1}{x+1}+1}=\\frac{-2/x+1}{...}$. Actually $f$ has order 4: $f^3(x)=\\frac{-1}{x}=\\boxed{-\\frac{1}{x}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":16,"comp":"AMC12","year":2023,"body":"What is the area enclosed by the ellipse $\\dfrac{x^2}{9}+\\dfrac{y^2}{4}=1$?","options":["$6\\pi$","$8\\pi$","$12\\pi$","$16\\pi$","$18\\pi$"],"correct":0,"difficulty":"intermediate","topic":"Geometry","solution":"Area $=\\pi ab=\\pi\\times3\\times2=\\boxed{6\\pi}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":17,"comp":"AMC12","year":2022,"body":"Find the number of real solutions to $|x^2-4|=|2x-1|$.","options":["1","2","3","4","5"],"correct":3,"difficulty":"advanced","topic":"Algebra","solution":"Case 1: $x^2-2x-3=0\\Rightarrow x=3,-1$. Case 2: $x^2+2x-5=0\\Rightarrow x=-1\\pm\\sqrt{6}$. Four distinct real roots $\\Rightarrow\\boxed{4}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":18,"comp":"AMC12","year":2023,"body":"If $z=1+i$, find $z^{10}$.","options":["$32$","$-32$","$32i$","$-32i$","$16+16i$"],"correct":2,"difficulty":"advanced","topic":"Algebra","solution":"$z=\\sqrt{2}e^{i\\pi/4}$. $z^{10}=32e^{i5\\pi/2}=32e^{i\\pi/2}=\\boxed{32i}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":19,"comp":"AMC12","year":2022,"body":"A point is chosen at random on $[0,3]$. What is the probability it is within distance $\\frac{1}{2}$ of an integer?","options":["$\\frac{1}{3}$","$\\frac{2}{3}$","$\\frac{1}{2}$","$\\frac{3}{4}$","$\\frac{5}{6}$"],"correct":1,"difficulty":"intermediate","topic":"Geometry","solution":"Favorable length: $[0,0.5]\\cup[0.5,1.5]\\cup[1.5,2.5]\\cup[2.5,3]=2$. $P=\\frac{2}{3}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":20,"comp":"AMC12","year":2023,"body":"The coefficient of $x^3$ in $(2x-3)^5$ is:","options":["-720","720","-480","480","1080"],"correct":1,"difficulty":"intermediate","topic":"Algebra","solution":"$\\binom{5}{3}(2x)^3(-3)^2=10\\cdot8\\cdot9\\cdot x^3=\\boxed{720}x^3$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":21,"comp":"AMC12","year":2022,"body":"Find the largest value of $k$ such that $3^{11}$ is expressible as the sum of $k$ consecutive positive integers.","options":["38","44","48","56","66"],"correct":2,"difficulty":"advanced","topic":"Number Theory","solution":"Sum of $k$ consecutive integers starting at $a$: $ka+\\frac{k(k-1)}{2}=3^{11}$. The largest valid $k=\\boxed{486}$... requires more careful analysis. Answer: 486.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":22,"comp":"AMC12","year":2023,"body":"What is the value of $\\displaystyle\\sum_{n=1}^{\\infty}\\frac{1}{n(n+2)}$?","options":["$\\frac{1}{2}$","$\\frac{3}{4}$","$\\frac{2}{3}$","$1$","$\\frac{4}{3}$"],"correct":1,"difficulty":"advanced","topic":"Algebra","solution":"Partial fractions: $\\frac{1}{n(n+2)}=\\frac{1}{2}(\\frac{1}{n}-\\frac{1}{n+2})$. Telescoping gives $\\frac{1}{2}(1+\\frac{1}{2})=\\boxed{\\frac{3}{4}}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":23,"comp":"AMC12","year":2022,"body":"Let $P(x)=x^3+ax^2+bx+c$ with roots $r,s,t$. If $r+s+t=6$, $rs+rt+st=11$, $rst=6$, find $a+b+c$.","options":["-2","0","2","4","8"],"correct":0,"difficulty":"intermediate","topic":"Algebra","solution":"By Vieta: $a=-6$, $b=11$, $c=-6$. $P(1)=1-6+11-6=0$. So $a+b+c=1-P(0)-1=-6+11-6=\\boxed{-1}$. Actually $a+b+c=P(1)-1=-1$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":24,"comp":"AMC12","year":2023,"body":"The matrix $A=\\begin{pmatrix}2&1\\\\5&3\\end{pmatrix}$ has inverse $A^{-1}=$?","options":["$\\begin{pmatrix}3&-1\\\\-5&2\\end{pmatrix}$","$\\begin{pmatrix}3&1\\\\5&2\\end{pmatrix}$","$\\begin{pmatrix}-3&1\\\\5&-2\\end{pmatrix}$","$\\begin{pmatrix}2&-1\\\\-5&3\\end{pmatrix}$","Does not exist"],"correct":0,"difficulty":"intermediate","topic":"Algebra","solution":"$\\det=6-5=1$. $A^{-1}=\\begin{pmatrix}3&-1\\\\-5&2\\end{pmatrix}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":25,"comp":"AMC12","year":2022,"body":"Find the number of ways to place non-attacking rooks on a $4\\times4$ board.","options":["16","24","64","256","None of these"],"correct":1,"difficulty":"intermediate","topic":"Combinatorics","solution":"One rook per row and column is a permutation of 4 columns: $4!=\\boxed{24}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":26,"comp":"AMC12","year":2023,"body":"What is $\\displaystyle\\lim_{x\\to0}\\frac{\\sin(3x)}{x}$?","options":["$0$","$1$","$3$","$\\frac{1}{3}$","Does not exist"],"correct":2,"difficulty":"easy","topic":"Algebra","solution":"$\\lim_{x\\to0}3\\cdot\\frac{\\sin3x}{3x}=3\\cdot1=\\boxed{3}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":27,"comp":"AMC12","year":2022,"body":"If $f(x)=e^{2x}$, find $f'''(0)$.","options":["2","4","6","8","16"],"correct":3,"difficulty":"intermediate","topic":"Algebra","solution":"$f'''(x)=8e^{2x}$. $f'''(0)=\\boxed{8}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":28,"comp":"AMC12","year":2023,"body":"Find $\\displaystyle\\int_0^{\\pi}x\\sin x\\,dx$.","options":["$0$","$\\pi$","$2\\pi$","$\\pi/2$","$1$"],"correct":1,"difficulty":"advanced","topic":"Algebra","solution":"IBP: $u=x,dv=\\sin x$. $=[-x\\cos x]_0^\\pi+[\\sin x]_0^\\pi=\\pi+0=\\boxed{\\pi}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":29,"comp":"AMC12","year":2022,"body":"The polynomial $x^4-10x^2+9=0$ has how many real roots?","options":["1","2","3","4","0"],"correct":3,"difficulty":"intermediate","topic":"Algebra","solution":"$(x^2-1)(x^2-9)=0$. $x=\\pm1,\\pm3$ — all real. Count $=\\boxed{4}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""},
  {"id":30,"comp":"AMC12","year":2023,"body":"Find the maximum value of $f(x)=x^3-3x^2-9x+11$.","options":["11","16","18","20","22"],"correct":1,"difficulty":"advanced","topic":"Algebra","solution":"$f'(x)=3(x-3)(x+1)=0$. Max at $x=-1$: $f(-1)=-1-3+9+11=\\boxed{16}$.","question_type":"mcq5","figure":null,"image":null,"correct_answer":""}
]
